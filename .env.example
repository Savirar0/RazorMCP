# Razorpay Test Mode credentials — never commit the real values.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_secret

# Groq exposes an OpenAI-compatible API for the seller agent.
GROQ_API_KEY=your_groq_api_key
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1

# Merchant guardrail policy
MAX_DISCOUNT_PERCENTAGE=20.0
MAX_TRANSACTION_LIMIT_INR=10000.0
ENVIRONMENT=development

# Hosting controls. Use demo mode for public portfolio deployments so a visitor
# cannot invoke paid LLM inference or create a Razorpay order.
DEMO_MODE=false
# Comma-separated trusted dashboard URLs in production, or * for local demos.
CORS_ORIGINS=*
